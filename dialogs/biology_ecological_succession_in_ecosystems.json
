        {
          "layout": "TitleBullets",
          "content": {
            "title": "What is Ecological Succession?",
            "bullets": [
              "Definition of ecological succession",
              "Importance in ecosystem dynamics",
              "Types: primary and secondary succession"
            ]
          }
        },
        {
          "layout": "TwoColumn",
          "content": {
            "left": {
              "title": "Primary Succession",
              "bullets": [
                "Occurs on barren surfaces",
                "Starts with pioneer species",
                "Examples: volcanic islands"
              ]
            },
            "right": {
              "title": "Secondary Succession",
              "bullets": [
                "Occurs after disturbances",
                "Soil and seeds remain",
                "Examples: forest fires"
              ]
            }
          }
        }
      ]
    },
    {
      "agenda_title": "Stages of Succession",
      "slides": [
        {
          "layout": "SplitLeftImage",
          "content": {
            "image": "stages_of_succession_diagram.png",
            "text": "Stages of ecological succession: from pioneer to climax community."
          }
        },
        {
          "layout": "TitleBullets",
          "content": {
            "title": "Climax Community",
            "bullets": [
              "Stable endpoint of succession",
              "Biodiversity and ecosystem balance",
              "Influenced by climate and soil"
            ]
          }
        }
      ]
    }

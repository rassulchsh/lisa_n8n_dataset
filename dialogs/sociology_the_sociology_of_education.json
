    "area": "Sociology",
    "title": "The Sociology of Education",
    "desc": "Explores the relationship between education systems and social inequality.",
    "duration_minutes": 20,
    "planner_source": "n8n_v2_github"
  },
  "plan": [
    {
      "agenda_title": "Introduction to Sociology of Education",
      "slides": [
        {
          "layout": "TitleBullets",
          "content": {
            "title": "Defining Sociology of Education",
            "bullets": [
              "Study of how education affects society",
              "Interrelationship between education and social structures",
              "Role of education in socialization"
            ]
          }
        },
        {
          "layout": "TitleOnly",
          "content": {
            "title": "Historical Context"
          }
        },
        {
          "layout": "Quote",
          "content": {
            "quote": "Education is the most powerful weapon which you can use to change the world. - Nelson Mandela"
          }
        }
      ]
    },
    {
      "agenda_title": "Key Theoretical Perspectives",
      "slides": [
        {
          "layout": "TitleBullets",
          "content": {
            "title": "Functionalism",
            "bullets": [
              "Education as a means of social stability",
              "Transmission of culture and values",
              "Preparation for workforce"
            ]
          }
        },
        {
          "layout": "TwoColumn",
          "content": {
            "left": {
              "title": "Conflict Theory",
              "bullets": [
                "Education perpetuates social inequalities",
                "Access based on socioeconomic status",
                "Role of power dynamics"
              ]
            },
            "right": {
              "title": "Symbolic Interactionism",
              "bullets": [
                "Focus on individual interactions",
                "Impact of labels and expectations",
                "Role of teacher-student relationships"
              ]
            }
          }
        }
      ]
    },
    {
      "agenda_title": "Contemporary Issues in Education",
      "slides": [
        {
          "layout": "SplitLeftImage",
          "content": {
            "title": "Equity in Education",
            "image": "equity_image.jpg",
            "text": "Challenges in providing equal opportunities for all students."
          }
        },
        {
          "layout": "FullImage",
          "content": {
            "title": "Technology in Education",
            "image": "technology_in_education.jpg"
          }
        },
        {
          "layout": "TitleBullets",
          "content": {
            "title": "Globalization and Education",
            "bullets": [
              "Influence of global standards",
              "Cross-cultural educational exchanges",
              "Impact on local educational systems"
            ]
          }
        }
      ]
    }
  ],

        {
          "layout": "TitleBullets",
          "content": {
            "title": "Defining Postmodernism",
            "bullets": [
              "Characteristics of postmodern thought",
              "Historical context",
              "Influence on art and culture"
            ]
          }
        },
        {
          "layout": "TitleBullets",
          "content": {
            "title": "Key Theorists",
            "bullets": [
              "Jean-François Lyotard",
              "Jacques Derrida",
              "Michel Foucault"
            ]
          }
        }
      ]
    },
    {
      "agenda_title": "Deconstruction of Artistic Authority",
      "slides": [
        {
          "layout": "TitleBullets",
          "content": {
            "title": "Concept of Deconstruction",
            "bullets": [
              "Origin in literary theory",
              "Application to visual arts",
              "Challenge to traditional hierarchies"
            ]
          }
        },
        {
          "layout": "Quote",
          "content": {
            "title": "Derrida on Deconstruction",
            "quote": "\"There is nothing outside the text.\""
          }
        },
        {
          "layout": "TwoColumn",
          "content": {
            "left": {
              "title": "Impact on Artists",
              "bullets": [
                "Reevaluation of authorship",
                "Collaboration and collective creation"
              ]
            },
            "right": {
              "title": "Audience Reception",
              "bullets": [
                "Active participation",
                "Interpretative freedom"
              ]
            }
          }
        }
      ]
    },
    {
      "agenda_title": "Case Studies",
      "slides": [
        {
          "layout": "SplitLeftImage",
          "content": {
            "left": {
              "title": "Marcel Duchamp's 'Fountain'",
              "bullets": [
                "Challenge to traditional art",
                "Conceptual vs. aesthetic value"
              ]
            },
            "right": {
              "image": "duchamp_fountain.jpg"
            }
          }
        },
        {
          "layout": "FullImage",
          "content": {
            "title": "Banksy's Street Art",
            "image": "banksy_art.jpg"
          }
        }
      ]
    }
